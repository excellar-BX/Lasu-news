{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.lasunews.com.ng/sitemap.xml"
    },
    {
      "source": "/news/:slug",
      "destination": "https://api.lasunews.com.ng/api/posts/og/:slug"
    }
  ],
  "routes": [
    {
      "src": "/news/(.*)",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}