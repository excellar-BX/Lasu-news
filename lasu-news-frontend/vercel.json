{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.lasunews.com.ng/sitemap.xml"
    },
    {
      "source": "/news/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Twitterbot|WhatsApp|LinkedInBot|TelegramBot|Googlebot).*"
        }
      ],
      "destination": "https://api.lasunews.com.ng/api/posts/og/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}